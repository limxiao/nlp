{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "astro/client"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "playwright.config.ts"
  ]
}
